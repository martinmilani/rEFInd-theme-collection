---
import "@fontsource-variable/onest";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  url?: string;
}

const {
  title = "rEFInd Themes Collection – Customize Your Boot Manager",
  description = "Browse minimalist, dark, and colorful themes for rEFInd, the UEFI boot manager. Image previews for all themes and direct download links to customize your boot screen.",
  image = "/og-cover.png",
  url = "https://refind-themes-collection.netlify.app"
} = Astro.props;

const fullImageUrl = new URL(image, url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-3R8G6ZRQ76"
    ></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-3R8G6ZRQ76");
    </script>
    <!-- Basic Meta -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:site_name" content="rEFInd Themes Collection" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />

    <!-- Canonical URL -->
    <link rel="canonical" href={url} />

    <!-- Keywords -->
    <meta
      name="keywords"
      content="refind themes, boot manager customization, UEFI themes, rEFInd boot manager, boot screen themes, linux boot manager, customize bootloader"
    />

    <!-- JSON-LD Structured Data for SEO / GEO -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "@id": "https://refind-themes-collection.netlify.app/#website",
            "url": "https://refind-themes-collection.netlify.app",
            "name": "rEFInd Themes Collection",
            "description": "Curated collection of 139 clean, minimalist, and dark themes for the rEFInd UEFI boot manager. Image previews for all themes, screenshots, and direct download links.",
            "publisher": {
              "@type": "Person",
              "name": "Martin Milani",
              "url": "https://github.com/martinmilani"
            }
          },
          {
            "@type": "CollectionPage",
            "@id": "https://refind-themes-collection.netlify.app/#webpage",
            "url": "https://refind-themes-collection.netlify.app",
            "name": "rEFInd Themes Gallery",
            "isPartOf": {
              "@id": "https://refind-themes-collection.netlify.app/#website"
            },
            "description": "Browse minimalist, dark, and colorful themes for rEFInd, the UEFI boot manager. Image previews for all themes and direct download links to customize your boot screen."
          },
          {
            "@type": "HowTo",
            "@id": "https://refind-themes-collection.netlify.app/#howto",
            "name": "How to Install a rEFInd Theme",
            "description": "Step-by-step instructions to download and apply a custom theme for the rEFInd UEFI boot manager.",
            "step": [
              {
                "@type": "HowToStep",
                "name": "Locate the Themes Directory",
                "text": "Find or create the 'themes' directory within your rEFInd installation directory (typically /boot/efi/EFI/refind/themes/)."
              },
              {
                "@type": "HowToStep",
                "name": "Download the Theme",
                "text": "Clone the chosen theme repository or extract its files directly into the 'themes' directory."
              },
              {
                "@type": "HowToStep",
                "name": "Modify refind.conf",
                "text": "Open refind.conf in a text editor with admin rights and append 'include themes/theme-folder-name/theme.conf' at the end."
              },
              {
                "@type": "HowToStep",
                "name": "Reboot",
                "text": "Save the configuration file and reboot your computer to see the newly applied theme."
              }
            ]
          },
          {
            "@type": "FAQPage",
            "@id": "https://refind-themes-collection.netlify.app/#faq",
            "mainEntity": [
              {
                "@type": "Question",
                "name": "What is rEFInd?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "rEFInd is an advanced, open-source UEFI boot manager maintained by Rod Smith. It is designed to manage multi-boot environments (such as Linux, macOS, and Windows) with a clean graphical user interface."
                }
              },
              {
                "@type": "Question",
                "name": "Where is the refind.conf configuration file located?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "The path to refind.conf varies: /boot/efi/EFI/refind/refind.conf on Linux, /Volumes/ESP/EFI/refind/refind.conf on macOS (after mounting the ESP), or S:\\EFI\\refind\\refind.conf on Windows after mounting ESP to drive S:."
                }
              },
              {
                "@type": "Question",
                "name": "How do I install a rEFInd theme?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "To install a rEFInd theme: 1. Locate/create /boot/efi/EFI/refind/themes/. 2. Clone/download the theme files into that directory. 3. Edit /boot/efi/EFI/refind/refind.conf and append 'include themes/theme-folder-name/theme.conf' at the bottom."
                }
              },
              {
                "@type": "Question",
                "name": "Can I customize OS icons and backgrounds in rEFInd themes?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Yes. rEFInd themes define custom graphics for OS selection icons, tool icons, and backgrounds. You can manually replace individual PNG assets in the theme folder."
                }
              }
            ]
          }
        ]
      }
    </script>
    <script is:inline>
      // On page load or when changing themes, best to add inline in `head` to avoid FOUC
      if (
        localStorage.getItem("color-theme") === "dark" ||
        (!("color-theme" in localStorage) &&
          window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script>
  </head>

  <body class="bg-gray-50 text-gray-900 dark:bg-gray-900 dark:text-white">
    <slot />
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/1.8.1/flowbite.min.js"
    ></script>
  </body>
</html>
<style is:global>
  :root {
    color-scheme: light dark;
  }
  html {
    font-family: "Onest Variable", system-ui, sans-serif;
    scroll-behavior: smooth;
  }

  @media (prefers-reduce-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
