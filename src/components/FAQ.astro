---
import InstallSteps from "@components/InstallSteps.astro";
---

<dialog id="faq-dialog" aria-labelledby="faq-title">
  <div class="faq-panel">
    <button type="button" class="faq-close" aria-label="Close help dialog">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        ><line x1="18" y1="6" x2="6" y2="18"></line><line
          x1="6"
          y1="6"
          x2="18"
          y2="18"></line></svg
      >
    </button>

    <div class="faq-head">
      <h2 id="faq-title">Help</h2>
      <p>Everything you need to install and enable a rEFInd theme.</p>
    </div>

    <div class="faq-tabs" role="tablist" aria-label="Help sections">
      <button
        type="button"
        class="faq-tab"
        role="tab"
        id="faq-tab-1"
        aria-controls="faq-panel-1"
        aria-selected="true">Install</button
      >
      <button
        type="button"
        class="faq-tab"
        role="tab"
        id="faq-tab-2"
        aria-controls="faq-panel-2"
        aria-selected="false"
        tabindex="-1">refind.conf</button
      >
      <button
        type="button"
        class="faq-tab"
        role="tab"
        id="faq-tab-3"
        aria-controls="faq-panel-3"
        aria-selected="false"
        tabindex="-1">Customize</button
      >
      <button
        type="button"
        class="faq-tab"
        role="tab"
        id="faq-tab-4"
        aria-controls="faq-panel-4"
        aria-selected="false"
        tabindex="-1">About</button
      >
    </div>

    <div class="faq-panels">
      <div
        class="faq-tp is-on"
        id="faq-panel-1"
        role="tabpanel"
        aria-labelledby="faq-tab-1"
      >
        <InstallSteps />
      </div>

      <div
        class="faq-tp"
        id="faq-panel-2"
        role="tabpanel"
        aria-labelledby="faq-tab-2"
      >
        <h3>Where is <code>refind.conf</code>?</h3>
        <p>The location depends on your operating system:</p>
        <ul>
          <li>
            <strong>Linux:</strong>
            <code>/boot/efi/EFI/refind/refind.conf</code> or <code
              >/boot/EFI/refind/refind.conf</code
            >
          </li>
          <li>
            <strong>macOS:</strong>
            <code>/Volumes/ESP/EFI/refind/refind.conf</code> (mount the EFI System
            Partition first)
          </li>
          <li>
            <strong>Windows:</strong>
            <code>S:\EFI\refind\refind.conf</code> (after mounting the ESP to drive
            S: as Administrator)
          </li>
        </ul>
      </div>

      <div
        class="faq-tp"
        id="faq-panel-3"
        role="tabpanel"
        aria-labelledby="faq-tab-3"
      >
        <h3>Can I customize OS icons and backgrounds?</h3>
        <p>
          Yes. rEFInd themes define custom graphics for operating system icons
          (Linux, Windows, macOS, Arch, Ubuntu, etc.), tool icons (reboot,
          shutdown, firmware), selection highlights, and banner backgrounds.
          Swap or edit any <code>.png</code> file inside the theme's directory to
          suit your preferences.
        </p>
      </div>

      <div
        class="faq-tp"
        id="faq-panel-4"
        role="tabpanel"
        aria-labelledby="faq-tab-4"
      >
        <h3>What is rEFInd?</h3>
        <p>
          rEFInd is an advanced, open-source UEFI boot manager maintained by
          <a
            href="https://www.rodsbooks.com/refind/"
            target="_blank"
            rel="noopener noreferrer">Rod Smith</a
          >. Designed for systems that dual-boot or multi-boot, such as Linux
          distributions (Ubuntu, Arch, Fedora), macOS, and Windows, it offers a
          clean, visual alternative to text-only bootloaders like GRUB.
        </p>
      </div>
    </div>
  </div>
</dialog>

<style is:global>
  #faq-dialog {
    --faq-bg: #f9fafb;
    --faq-ink: #111827;
    --faq-mut: #4b5563;
    --faq-line: #e5e7eb;
    --faq-card: #fff;
    --faq-code: #f3f4f6;
    --faq-accent: #7d2eed;
    --faq-link: #6916e0;
    --faq-ease: cubic-bezier(0.16, 1, 0.3, 1);
    width: min(56rem, 94vw);
    max-width: none;
    max-height: none;
    margin: auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--faq-ink);
    overflow: visible;
  }
  .dark #faq-dialog {
    --faq-bg: #111827;
    --faq-ink: #fff;
    --faq-mut: #9ca3af;
    --faq-line: #374151;
    --faq-card: #1f2937;
    --faq-code: #0b1220;
    --faq-link: #a771f6;
  }
  #faq-dialog::backdrop {
    background: rgb(17 24 39 / 0.55);
  }
  .dark #faq-dialog::backdrop {
    background: rgb(17 24 39 / 0.8);
  }
  #faq-dialog .faq-panel {
    position: relative;
    max-height: 90vh;
    overflow-y: auto;
    border: 1px solid var(--faq-line);
    border-radius: 1rem;
    background: var(--faq-bg);
    box-shadow: 0 24px 60px -12px rgb(0 0 0 / 0.45);
  }
  /* :where keeps this below .install-steps rules, which style their own code */
  :where(#faq-dialog) code {
    padding: 1px 6px;
    border-radius: 5px;
    background: var(--faq-code);
    font-size: 0.85em;
  }
  #faq-dialog a:not(.install-tip a) {
    color: var(--faq-link);
  }
  #faq-dialog button:focus-visible,
  #faq-dialog a:focus-visible {
    outline: 2px solid var(--faq-accent);
    outline-offset: 2px;
  }
  .dark #faq-dialog button:focus-visible,
  .dark #faq-dialog a:focus-visible {
    outline-color: #a771f6;
  }

  #faq-dialog .faq-head {
    padding: 1.625rem 3.5rem 0 1.75rem;
  }
  #faq-dialog .faq-head h2 {
    margin: 0;
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  #faq-dialog .faq-head p {
    margin: 0.375rem 0 0;
    color: var(--faq-mut);
    max-width: 60ch;
  }
  #faq-dialog .faq-close {
    position: absolute;
    top: 0.875rem;
    right: 0.875rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: 0.5rem;
    background: transparent;
    color: var(--faq-mut);
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  #faq-dialog .faq-close:hover {
    background: var(--faq-code);
    color: var(--faq-ink);
  }

  /* Tabs share the row evenly, so there is nothing to scroll. */
  #faq-dialog .faq-tabs {
    display: flex;
    margin-top: 1rem;
    padding: 0 1.25rem;
    border-bottom: 1px solid var(--faq-line);
  }
  #faq-dialog .faq-tab {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    padding: 0.75rem 0.25rem;
    border: 0;
    background: none;
    color: var(--faq-mut);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: color 0.2s;
  }
  #faq-dialog .faq-tab:hover,
  #faq-dialog .faq-tab[aria-selected="true"] {
    color: var(--faq-ink);
  }
  #faq-dialog .faq-tab[aria-selected="true"]::after {
    content: "";
    position: absolute;
    left: 0.5rem;
    right: 0.5rem;
    bottom: -1px;
    height: 2px;
    border-radius: 2px;
    background: var(--faq-accent);
  }

  /* All panels occupy one grid cell, so the dialog keeps the tallest height. */
  #faq-dialog .faq-panels {
    display: grid;
    padding: 1.5rem 1.75rem 1.75rem;
  }
  #faq-dialog .faq-tp {
    grid-area: 1 / 1;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    color: var(--faq-mut);
    font-size: 0.95rem;
    line-height: 1.55;
  }
  #faq-dialog .faq-tp.is-on {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    animation: faq-tab 0.3s var(--faq-ease);
  }
  #faq-dialog .faq-tp h3 {
    margin: 0 0 0.5rem;
    color: var(--faq-ink);
    font-size: 1.1rem;
    font-weight: 700;
  }
  #faq-dialog .faq-tp p {
    margin: 0;
  }
  #faq-dialog .faq-tp ul {
    margin: 0.5rem 0 0;
    padding-left: 1.125rem;
    list-style: disc;
  }
  #faq-dialog .faq-tp ul > li {
    margin-top: 0.375rem;
  }
  #faq-dialog .faq-tp strong {
    color: var(--faq-ink);
  }

  /* Opening: panel rises and settles; steps and tip follow in sequence. */
  #faq-dialog[open] .faq-panel {
    animation: faq-pop 0.45s var(--faq-ease);
  }
  #faq-dialog[open]::backdrop {
    animation: faq-fade 0.35s var(--faq-ease);
  }
  #faq-dialog .faq-tp.is-on .install-steps ol > li,
  #faq-dialog .faq-tp.is-on .install-tip {
    animation: faq-rise 0.5s var(--faq-ease) both;
  }
  #faq-dialog .install-steps ol > li:nth-child(1) {
    animation-delay: 0.06s;
  }
  #faq-dialog .install-steps ol > li:nth-child(2) {
    animation-delay: 0.12s;
  }
  #faq-dialog .install-steps ol > li:nth-child(3) {
    animation-delay: 0.18s;
  }
  #faq-dialog .install-steps ol > li:nth-child(4) {
    animation-delay: 0.24s;
  }
  #faq-dialog .install-tip {
    animation-delay: 0.3s;
  }

  @keyframes faq-pop {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.97);
    }
  }
  @keyframes faq-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes faq-rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  @keyframes faq-tab {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #faq-dialog *,
    #faq-dialog,
    #faq-dialog::backdrop {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script is:inline>
  (function () {
    const dialog = document.getElementById("faq-dialog");
    if (!dialog) return;
    const tabs = Array.from(dialog.querySelectorAll(".faq-tab"));
    const panels = Array.from(dialog.querySelectorAll(".faq-tp"));

    function select(index, focus) {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
        panels[i].classList.toggle("is-on", on);
        if (on && focus) tab.focus();
      });
    }

    tabs.forEach((tab, i) => tab.addEventListener("click", () => select(i)));
    dialog.querySelector(".faq-tabs").addEventListener("keydown", (e) => {
      const i = tabs.findIndex(
        (t) => t.getAttribute("aria-selected") === "true"
      );
      const last = tabs.length - 1;
      const next =
        e.key === "ArrowRight"
          ? (i + 1) % tabs.length
          : e.key === "ArrowLeft"
            ? (i + last) % tabs.length
            : e.key === "Home"
              ? 0
              : e.key === "End"
                ? last
                : -1;
      if (next < 0) return;
      e.preventDefault();
      select(next, true);
    });

    dialog
      .querySelector(".faq-close")
      .addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });

    // Always start on the first tab when the dialog opens.
    new MutationObserver(() => {
      if (dialog.open) select(0);
    }).observe(dialog, { attributes: true, attributeFilter: ["open"] });
  })();
</script>
