---
import { getPopularity } from "@src/utils/popularity";
import { getCollection } from "astro:content";
import ThemeGallery from "./ThemeGallery.tsx";

const themes = await getCollection("themes");
const popularity = getPopularity(themes);
---

<section aria-labelledby="gallery-title">
  <h2 id="gallery-title" class="sr-only">Browse rEFInd themes</h2>
  <ThemeGallery client:load themes={themes} popularity={popularity} />
</section>
