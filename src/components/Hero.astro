---
import { getCollection } from "astro:content";

const themeCount = (await getCollection("themes")).length;
import ColorSwatchIcon from "@icons/ColorSwatchIcon.astro";
---

<section class="pb-10 pt-24" id="home">
  <div class="mx-auto max-w-screen-xl px-4 py-6 text-center lg:py-10">
    <div
      class="mb-4 flex flex-col items-center justify-center md:flex-row md:items-end"
    >
      <ColorSwatchIcon width={90} height={90} />
      <h1
        class="text-4xl font-extrabold leading-none tracking-tight text-gray-900 dark:text-white md:text-5xl lg:text-6xl"
      >
        <a href="https://rodsbooks.com/refind/" class="text-dracula-400"
          >rEFInd</a
        > Theme Collection
      </h1>
    </div>
    <p
      class="text-pretty text-lg font-normal text-gray-500 dark:text-gray-400 sm:px-16 lg:px-60 lg:text-xl"
    >
      Explore a curated repository of {themeCount} open-source rEFInd boot manager
      themes sourced from GitHub. Easily preview, choose, and install your favorite
      design to customize your UEFI boot screen for Linux, macOS, and Windows.
    </p>
  </div>
</section>
