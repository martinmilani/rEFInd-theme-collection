---
import EmailIcon from "@src/icons/EmailIcon.astro";
import GitHubIcon from "@src/icons/GitHubIcon.astro";
import HomeIcon from "@src/icons/HomeIcon.astro";
---

<footer class="m-4 rounded-lg bg-white shadow-sm dark:bg-gray-800">
  <div
    class="mx-auto w-full max-w-screen-2xl px-4 py-6 md:flex md:items-center md:justify-between"
  >
    <span class="text-sm text-gray-500 dark:text-gray-400 sm:text-center"
      >© 2025 <a href="https://github.com/martinmilani" class="hover:underline"
        >Martin Milani</a
      >. All Rights Reserved.
    </span>
    <ul
      class="mt-3 flex items-center space-x-4 text-gray-500 dark:text-gray-400 sm:mt-0 rtl:space-x-reverse"
    >
      <li>
        <a
          href="/#home"
          class="transition-colors hover:text-dracula-400 dark:hover:text-dracula-400"
          aria-label="Home"
        >
          <HomeIcon class="h-5 w-5" />
        </a>
      </li>
      <li>
        <a
          href="mailto:martin.milani.mdq@gmail.com"
          class="transition-colors hover:text-dracula-400 dark:hover:text-dracula-400"
          aria-label="Contact"
        >
          <EmailIcon class="h-5 w-5" />
        </a>
      </li>
      <li>
        <a
          href="https://github.com/martinmilani/rEFInd-theme-collection"
          class="transition-colors hover:text-dracula-400 dark:hover:text-dracula-400"
          aria-label="Github"
        >
          <GitHubIcon class="h-5 w-5" />
        </a>
      </li>
    </ul>
  </div>
</footer>
