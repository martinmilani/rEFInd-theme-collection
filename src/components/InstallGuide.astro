---
import InstallSteps from "@components/InstallSteps.astro";

interface Props {
  // Set on theme pages to show that theme's commands
  name?: string;
  repoUrl?: string;
  folder?: string;
  class?: string;
}

const {
  name,
  repoUrl,
  folder,
  class: className = "container mx-auto mb-16 px-4 lg:mb-24"
} = Astro.props;

const inlineCode = "rounded bg-gray-100 px-1.5 text-sm dark:bg-gray-900";
---

<section
  id="install"
  aria-labelledby="install-title"
  class:list={["scroll-mt-24", className]}
>
  <div
    class="install-surface grid gap-8 rounded-lg bg-white p-6 shadow-sm dark:bg-gray-800 md:p-10 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-16"
  >
    <div>
      <h2
        id="install-title"
        class="text-balance text-2xl font-extrabold tracking-tight text-gray-900 dark:text-white md:text-3xl"
      >
        {name ? `How to install ${name}` : "How to install a rEFInd theme"}
      </h2>
      <p class="mt-3 text-pretty text-gray-500 dark:text-gray-400">
        {
          name
            ? `${name} installs like any rEFInd theme: clone it into rEFInd's `
            : "Every theme in the collection installs the same way: copy it into rEFInd's "
        }<code class={inlineCode}>themes</code> folder and include it from
        <code class={inlineCode}>refind.conf</code>.
      </p>
      <p class="mt-6 text-pretty text-sm text-gray-500 dark:text-gray-400">
        <strong class="block font-medium text-gray-900 dark:text-white"
          >Where is refind.conf?</strong
        >
        On Linux it's usually <code class={inlineCode}
          >/boot/efi/EFI/refind/refind.conf</code
        >. On macOS and Windows, mount the EFI System Partition first; open the
        help dialog (<span aria-hidden="true">?</span> in the header) for every path.
      </p>
    </div>

    <InstallSteps repoUrl={repoUrl} folder={folder} />
  </div>
</section>
